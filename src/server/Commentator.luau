local function fill(template: string, args: { string }): string
	return (string.gsub(template, "{(%d)}", function(n)
		return args[tonumber(n)] or "кто-то"
	end))
end

-- kind — тип события, дальше — имена участников
function Commentator.say(kind: string, ...: string)
	local list = PHRASES[kind]
	if not list then
		return
	end
	local text = fill(list[math.random(1, #list)], { ... })
	Remotes.get("Comment"):FireAllClients(text)
end

return Commentator
